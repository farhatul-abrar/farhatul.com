---
import Layout from "../layouts/Layout.astro";

const profiles = [
  {
    label: "Google Scholar",
    href: "https://scholar.google.com/citations?user=cqm9I9UAAAAJ&hl=en",
  },
  {
    label: "ResearchGate",
    href: "https://www.researchgate.net/profile/Md-Farhatul-Abrar-2?ev=hdr_xprf",
  },
  { label: "ORCID", href: "https://orcid.org/0009-0008-9081-6463" },
];
---

<Layout
  title="Publications | Md. Farhatul Abrar"
  description="Publications by Md. Farhatul Abrar on life-cycle assessment, hydrothermal carbonization, and waste-to-energy processes."
>
  <main class="page">
    <h1>Publications</h1>

    <p class="profiles">
      <span class="profiles-label">Profiles:</span>
      {
        profiles.map((p, i) => (
          <>
            {i > 0 && <span class="sep">&middot;</span>}
            <a href={p.href} target="_blank" rel="noopener noreferrer">
              {p.label}
            </a>
          </>
        ))
      }
    </p>

    <section class="pub-group">
      <h2>Published</h2>
      <ol class="pub-list">
        <li>
          Chambers, C., <strong>Abrar, M. F.</strong>, Grimes, S., Kirtania,
          K., &amp; Reza, M. T. (2026).
          <a
            href="https://doi.org/10.1016/j.nxsust.2026.100524"
            target="_blank"
            rel="noopener noreferrer"
            >Techno-economic analysis and life-cycle assessment of pyrolyzed
            hydrochar production from waste corn stover</a
          >. <em>Next Sustainability, 8</em>, Article 100524.
        </li>
        <li>
          Rahman, K. F., <strong>Abrar, M. F.</strong>, Tithi, S. S., Kabir,
          K. B., &amp; Kirtania, K. (2024).
          <a
            href="https://doi.org/10.1016/j.jenvman.2024.122850"
            target="_blank"
            rel="noopener noreferrer"
            >Life cycle assessment of hydrothermal carbonization of
            municipal solid waste for waste-to-energy generation</a
          >. <em>Journal of Environmental Management, 370</em>, Article
          122850.
        </li>
      </ol>
    </section>

    <section class="pub-group">
      <h2>Under Review</h2>
      <ol class="pub-list" start="3">
        <li>
          <strong>Abrar, M. F.</strong>, Ahsan, S., Khatun, M. L., Saha, C.
          K., Kabir, K. B., &amp; Kirtania, K. Comparative life cycle
          assessment of open dumping, land application, composting and
          hydrothermal carbonization of anaerobic digestate. Submitted to <em
            >Bioresource Technology Reports</em
          >, August 2026.
        </li>
        <li>
          Ahmed, F., <strong>Abrar, M. F.</strong>, Sonnet, H. M. S., Srabon,
          F. S., Jannat, M., &amp; Kirtania, K. Life cycle assessment of
          phase change material supported on sugarcane bagasse-derived
          biochar for building energy storage. Submitted to <em
            >Energy Reports</em
          >, August 2026.
        </li>
      </ol>
    </section>

    <section class="pub-group">
      <h2>Manuscripts in Preparation</h2>
      <ol class="pub-list" start="5">
        <li>
          Ahsan, S., <strong>Abrar, M. F.</strong>, Kabir, K. B., &amp;
          Kirtania, K. Optimization of hydrothermal carbonization reaction
          conditions for nutrient recovery from bio-slurry. Manuscript in
          preparation.
        </li>
        <li>
          Alam, M. S., Prangon, R. D., <strong>Abrar, M. F.</strong>, Ahmed,
          F., Kabir, K. B., &amp; Kirtania, K. Framework development for
          biorefinery process repository and superstructure generation for
          LCA metric-based decision making. Manuscript in preparation.
        </li>
        <li>
          Rama, S. S., Hasan, A. M. S., <strong>Abrar, M. F.</strong>,
          Ahmed, F., Islam, N., &amp; Kirtania, K. Cradle-to-gate life cycle
          assessment of PVA&ndash;chitosan&ndash;collagen peptide hydrogel
          production. Manuscript in preparation.
        </li>
      </ol>
    </section>

    <section class="pub-group">
      <h2>Conference Presentations</h2>
      <ol class="pub-list" start="8">
        <li>
          <strong>Abrar, M. F.</strong>, Rana, S., Mimmi, S. F., Saha, C. K.,
          &amp; Kirtania, K. (2023). CFD simulation of a natural convection
          mixed-mode solar dryer using OpenFOAM. Oral presentation at the
          7th International Conference on Chemical Engineering (ICChE 2023),
          Dhaka, Bangladesh.
        </li>
      </ol>
    </section>
  </main>

  <style>
    .page {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 24px 120px;
    }

    h1 {
      font-family: var(--font-head);
      font-size: 2rem;
      font-weight: 700;
      margin: 0 0 16px;
      letter-spacing: -0.01em;
    }

    .profiles {
      font-family: var(--font-head);
      font-size: 0.95rem;
      margin: 0 0 40px;
      color: var(--text-muted);
      display: flex;
      flex-wrap: wrap;
      gap: 6px 10px;
      align-items: baseline;
    }

    .profiles a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }

    .profiles a:hover {
      text-decoration: underline;
    }

    .pub-group {
      margin-bottom: 44px;
    }

    h2 {
      font-family: var(--font-head);
      font-size: 1.1rem;
      font-weight: 600;
      margin: 0 0 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .pub-list {
      margin: 0;
      padding-left: 1.4em;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .pub-list li {
      font-size: 1rem;
      line-height: 1.75;
      padding-left: 4px;
    }

    .pub-list a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: var(--border);
      text-underline-offset: 2px;
    }

    .pub-list a:hover {
      text-decoration-color: var(--accent);
    }
  </style>
</Layout>