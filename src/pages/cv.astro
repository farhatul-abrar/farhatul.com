---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="CV | Md. Farhatul Abrar"
  description="Curriculum vitae of Md. Farhatul Abrar, Lecturer in Chemical Engineering at BUET."
>
  <main class="page">
    <div class="cv-header">
      <h1>Curriculum Vitae</h1>
      <a class="download-btn" href="/CV_Md_Farhatul_Abrar.pdf" target="_blank" rel="noopener noreferrer">
        Download Full CV (PDF)
      </a>
    </div>

    <section>
      <h2>Education</h2>
      <ul class="entry-list">
        <li>
          <div class="entry-row">
            <span class="entry-title">M.Sc. in Chemical Engineering</span>
            <span class="entry-date">July 2023 – January 2025</span>
          </div>
          <span class="entry-meta"
            >Bangladesh University of Engineering and Technology (BUET) &middot; CGPA 3.83/4.00</span
          >
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">B.Sc. in Chemical Engineering</span>
            <span class="entry-date">March 2018 – May 2023</span>
          </div>
          <span class="entry-meta"
            >Bangladesh University of Engineering and Technology (BUET) &middot; CGPA 3.89/4.00, Class Rank 4/60 (Top 7%)</span
          >
        </li>
      </ul>
    </section>

    <section>
      <h2>Academic Positions</h2>
      <ul class="entry-list">
        <li>
          <div class="entry-row">
            <span class="entry-title">Lecturer</span>
            <span class="entry-date">May 2025 – Present</span>
          </div>
          <span class="entry-meta">Department of Chemical Engineering, BUET</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">Research Assistant</span>
            <span class="entry-date">July 2023 – December 2024</span>
          </div>
          <span class="entry-meta">Department of Chemical Engineering, BUET</span>
        </li>
      </ul>
    </section>

    <section>
      <h2>Research</h2>
      <ul class="research-list">
        <li>
          <span class="research-title"
            >Research Assistant, <a href="https://seer-group.org/" target="_blank" rel="noopener noreferrer">SEER Group</a>, BUET</span
          >
          <p>
            Valorization of bio-slurry from anaerobic digestion via
            hydrothermal carbonization — LCA modeling, bio-slurry/HTC
            product characterization, and RSM-based process optimization.
          </p>
        </li>
        <li>
          <span class="research-title">M.Sc. Thesis</span>
          <p>
            Life Cycle Assessment of Anaerobic Digestate Valorization
            through Hydrothermal Carbonization.
          </p>
        </li>
        <li>
          <span class="research-title">Undergraduate Thesis</span>
          <p>
            CFD Simulation of a Natural Convection Mixed-mode Solar Dryer
            using OpenFOAM.
          </p>
        </li>
      </ul>
      <a class="section-link" href="/research">See current research focus →</a>
    </section>

    <section>
      <h2>Publications</h2>
      <p class="summary-text">
        1 published journal article, 1 conference presentation, 3
        manuscripts under review, and 3 manuscripts in preparation.
      </p>
      <a class="section-link" href="/publications">See full publication list →</a>
    </section>

    <section>
      <h2>Teaching</h2>
      <p class="summary-text">
        2 theory courses and 6 sessional/laboratory courses in the
        Department of Chemical Engineering, BUET.
      </p>
      <a class="section-link" href="/teaching">See all courses →</a>
    </section>

    <section>
      <h2>Awards</h2>
      <ul class="entry-list">
        <li>
          <div class="entry-row">
            <span class="entry-title"
              >Donald F. &amp; Mildred Topp Othmer Scholarship Award</span
            >
            <span class="entry-date">2021 – 2022</span>
          </div>
          <span class="entry-meta">AIChE</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">BUET Dean's List</span>
            <span class="entry-date">2019 – 2023</span>
          </div>
          <span class="entry-meta">Awarded for four consecutive years</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">University Merit Scholarship</span>
            <span class="entry-date">2019 – 2023</span>
          </div>
          <span class="entry-meta">Awarded for four consecutive years</span>
        </li>
      </ul>
    </section>

    <section>
      <h2>Professional Activities</h2>
      <ul class="entry-list">
        <li>
          <div class="entry-row">
            <span class="entry-title">In-Plant Trainee</span>
            <span class="entry-date">April 2022</span>
          </div>
          <span class="entry-meta">Karnaphuli Fertilizer Company Limited</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">Regional Liaison</span>
            <span class="entry-date">July 2021 – July 2022</span>
          </div>
          <span class="entry-meta">Southern Asia Region ESC, AIChE</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">Student Secretary</span>
            <span class="entry-date">October 2021 – January 2023</span>
          </div>
          <span class="entry-meta">BUET AIChE Student Chapter</span>
        </li>
        <li>
          <div class="entry-row">
            <span class="entry-title">Treasurer</span>
            <span class="entry-date">August 2020 – September 2021</span>
          </div>
          <span class="entry-meta">BUET AIChE Student Chapter</span>
        </li>
      </ul>
    </section>
  </main>

  <style>
    .page {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 24px 120px;
    }

    .cv-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin: 0 0 44px;
    }

    h1 {
      font-family: var(--font-head);
      font-size: 2rem;
      font-weight: 700;
      margin: 0;
      letter-spacing: -0.01em;
    }

    .download-btn {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      color: #fff;
      background: var(--accent);
      padding: 11px 20px;
      border-radius: 6px;
      white-space: nowrap;
    }

    section {
      margin-bottom: 44px;
    }

    h2 {
      font-family: var(--font-head);
      font-size: 1.1rem;
      font-weight: 600;
      margin: 0 0 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .entry-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .entry-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
    }

    .entry-title {
      font-weight: 500;
      font-size: 1.02rem;
    }

    .entry-date {
      font-family: var(--font-head);
      font-size: 0.88rem;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .entry-meta {
      display: block;
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 2px;
    }

    .research-list {
      list-style: none;
      margin: 0 0 16px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .research-title {
      display: block;
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .research-title a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--border);
      text-underline-offset: 2px;
    }

    .research-list p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.75;
      text-align: justify;
    }

    .summary-text {
      font-size: 1.05rem;
      line-height: 1.75;
      margin: 0 0 16px;
    }

    .section-link {
      display: inline-block;
      font-family: var(--font-head);
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--accent);
      text-decoration: none;
    }

    .section-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 500px) {
      .cv-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</Layout>